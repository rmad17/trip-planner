<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Site Administration | Trip Planner Administration</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: "Roboto","Lucida Grande","DejaVu Sans","Bitstream Vera Sans",Verdana,Arial,sans-serif;
            font-size: 14px;
            color: #333;
            background: #f8f8f8;
        }
        #header {
            background: #417690;
            padding: 12px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        #header h1 { font-size: 18px; font-weight: 300; }
        #header h1 a { color: #fff; text-decoration: none; }
        #user-tools { font-size: 13px; color: #c4dce8; }
        #user-tools a { color: #fff; text-decoration: none; margin-left: 8px; }
        #user-tools a:hover { text-decoration: underline; }
        #breadcrumbs {
            background: #79aec8;
            padding: 8px 40px;
            font-size: 13px;
            color: #fff;
        }
        #content { padding: 28px 40px; }
        #content h1 { font-size: 22px; font-weight: 400; margin-bottom: 24px; }
        .module {
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            margin-bottom: 24px;
            overflow: hidden;
        }
        .module h2 {
            background: #417690;
            color: #fff;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: .3px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 1px;
            background: #e8e8e8;
        }
        .stat-card {
            background: #fff;
            padding: 24px 16px;
            text-align: center;
        }
        .stat-card .count {
            font-size: 40px;
            font-weight: 700;
            color: #417690;
            line-height: 1;
        }
        .stat-card .label {
            font-size: 13px;
            color: #666;
            margin-top: 6px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }
        .module table {
            width: 100%;
            border-collapse: collapse;
        }
        .module table th {
            background: #f0f0f0;
            padding: 8px 16px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            border-bottom: 1px solid #e0e0e0;
        }
        .module table td {
            padding: 8px 16px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 13px;
        }
        .module table tr:last-child td { border-bottom: none; }
        .action-link {
            display: inline-block;
            padding: 5px 12px;
            background: #417690;
            color: #fff;
            border-radius: 3px;
            text-decoration: none;
            font-size: 12px;
        }
        .action-link:hover { background: #205067; }
        #footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: #999;
            border-top: 1px solid #e8e8e8;
        }
    </style>
</head>
<body>
<div id="header">
    <h1><a href="/admin/">Trip Planner Administration</a></h1>
    <div id="user-tools">
        Welcome, <strong>{{.User.Email}}</strong> &nbsp;|&nbsp;
        <a href="/admin/logout">Log out</a>
    </div>
</div>
<div id="breadcrumbs">Home</div>
<div id="content">
    <h1>Site Administration</h1>

    <div class="module">
        <h2>Overview</h2>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="count">{{.Stats.Users}}</div>
                <div class="label">Users</div>
            </div>
            <div class="stat-card">
                <div class="count">{{.Stats.Admins}}</div>
                <div class="label">Admins</div>
            </div>
            <div class="stat-card">
                <div class="count">{{.Stats.Trips}}</div>
                <div class="label">Trips</div>
            </div>
            <div class="stat-card">
                <div class="count">{{.Stats.Expenses}}</div>
                <div class="label">Expenses</div>
            </div>
            <div class="stat-card">
                <div class="count">{{.Stats.Documents}}</div>
                <div class="label">Documents</div>
            </div>
        </div>
    </div>

    <div class="module">
        <h2>Manage</h2>
        <table>
            <tr>
                <th>Resource</th>
                <th>Actions</th>
            </tr>
            <tr>
                <td>Users</td>
                <td><a class="action-link" href="/api/v1/admin/users">View via API</a></td>
            </tr>
            <tr>
                <td>Trips</td>
                <td><a class="action-link" href="/api/v1/admin/trips">View via API</a></td>
            </tr>
            <tr>
                <td>Expenses</td>
                <td><a class="action-link" href="/api/v1/admin/expenses">View via API</a></td>
            </tr>
            <tr>
                <td>Documents</td>
                <td><a class="action-link" href="/api/v1/admin/documents">View via API</a></td>
            </tr>
        </table>
    </div>
</div>
<p id="footer">Trip Planner Administration</p>
</body>
</html>
